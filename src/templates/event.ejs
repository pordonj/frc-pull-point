<!doctype html>
<html>
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no">
    <title>FRC PullPoint - <%= event %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body class="d-flex flex-column min-vh-100 bg-dark text-light">
    <header class="bg-dark border-bottom border-secondary py-3">
      <div class="container">
        <h1 class="h3 mb-0 text-light">FRC PullPoint - Reinspection for <%= event %></h1>
      </div>
    </header>

    <main class="container my-4">
      <div class="card bg-secondary text-light shadow-sm">
        <div class="card-body">
          <h2 class="h4 text-warning">Reinspection summary</h2>
          <p class="mb-2">Match <span class="fw-bold text-white"><%= firstMatch %></span></p>
          <p class="mb-2">Reinspect teams</p>
          <div class="bg-dark border border-light rounded p-2 text-wrap" style="word-break: break-word;">
            <span class="fw-bold text-info"><%= teams %></span>
          </div>
          <p class="mt-3 mb-0 text-light">Then reinspect each listed team in remaining matches.</p>
        </div>
      </div>
    </main>

    <%- footerHtml %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
