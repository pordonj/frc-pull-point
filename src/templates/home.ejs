<!doctype html>
<html>
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no">
    <title>FRC PullPoint</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body class="d-flex flex-column min-vh-100 bg-dark text-light">
    <header class="bg-dark border-bottom border-secondary py-3">
      <div class="container">
        <h1 class="h3 mb-0 text-light">Welcome to FRC PullPoint!</h1>
      </div>
    </header>

    <main class="container my-4">
      <div class="card bg-secondary text-light shadow-sm">
        <div class="card-body">
          <h2 class="h4 text-warning">Get started</h2>
          <p>To use, go to <code>[this_url]/[event_code]</code> for any event code that has had its match schedule generated.</p>
          <p class="text-light small mb-0">Example: <code>/2026wiply</code></p>
        </div>
      </div>
    </main>

    <%- footerHtml %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
